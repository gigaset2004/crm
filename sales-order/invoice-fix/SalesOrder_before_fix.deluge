			v4x = v24.get("Sales_Order");
			if(ifnull(v24.get("Request_Key"),"").toString() == v4m && ifnull(v24.get("Request_Source"),"").toString() == "Sales Orders" && v4x != null && ifnull(v4x.get("id"),"").toString() == sid)
			{
				v1z = v24;
				v2o = v2o + 1;
			}
		}
	}
	if(v2o != 1 || v1z == null)
	{
		info "[SO Dep Rec] ERROR: Expected one linked Accounting deposit request, found " + v2o;
		return;
