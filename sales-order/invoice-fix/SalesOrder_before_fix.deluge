void automation.SalesOrder(String salesOrderId)
{
sid = salesOrderId;
info "[SalesOrder] START. SO=" + sid;
if(sid == null || sid.trim() == "")
{
	info "[SalesOrder] ERROR: Empty Sales Order ID";
	return;
}
v48 = zoho.crm.getRecordById("Sales_Orders",sid.toLong());
if(v48 == null || v48.get("id") == null)
{
	info "[SalesOrder] ERROR: Sales Order not found";
	return;
}
xid = "";
xown = v48.get("Owner");
if(xown != null)
{
	try 
	{
		xu = zoho.crm.getRecordById("users",xown.get("id").toLong());
		if(xu != null)
		{
			xl = xu.get("users");
			if(xl != null && !xl.isEmpty())
			{
				xid = ifnull(xl.get(0).get("Front_Teammate_ID"),"").toString();
			}
			else
			{
				xid = ifnull(xu.get("Front_Teammate_ID"),"").toString();
			}
		}
	}
	catch (xe)
	{
		info "[Front ID] Native lookup " + xe;
	}
	if(xid == "")
	{
		try 
		{
			xu = invokeapi
			[
				service :zohocrm
				path :"/crm/v8/users/" + xown.get("id").toString()
				type :GET
			];
			xl = xu.get("users");
			if(xl != null && !xl.isEmpty())
			{
				xid = ifnull(xl.get(0).get("Front_Teammate_ID"),"").toString();
			}
		}
		catch (xe2)
		{
			info "[Front ID] API lookup " + xe2;
		}
	}
}
if(xid != "" && !xid.startsWith("tea_"))
{
	xid = "";
}
if(xid == "")
{
	info "[Front ID] User ID missing SO=" + sid;
}
vx = ifnull(v48.get("Accounting_status"),"").toString().trim();
v0 = "sync_qbo";
if(vx == "Send invoice")
{
	v0 = "request_full";
	v5e = "SO_" + sid + "_DEPOSIT";
	v4q = zoho.crm.searchRecords("Accounting","(Request_Key:equals:" + v5e + ")",1,10);
	if(v4q != null && v4q.size() == 1)
	{
		v49 = v4q.get(0);
		v52 = v49.get("Sales_Order");
		v4u = ifnull(v49.get("Request_Status"),"").toString();
		if(v52 != null && ifnull(v52.get("id"),"").toString() == sid && ifnull(v49.get("Request_Source"),"").toString() == "Sales Orders" && ifnull(v49.get("QBO_Invoice_ID"),"").toString() != "" && ifnull(v49.get("Payment_Amount"),0).toDecimal().round(2) == ifnull(v48.get("Grand_Total"),0).toDecimal().round(2) && (v4u == "To Receive" || v4u == "Invoice sent"))
		{
			v0 = "invoice";
		}
	}
}
else if(vx == "Paid")
{
	v0 = "payment_received";
}
else if(vx == "Send balance invoice")
{
	v0 = "remainder";
}
else if(vx == "Send deposit invoice" || vx == "Deposit paid")
{
	v53 = "SO_" + sid + "_DEPOSIT";
	v3p = zoho.crm.searchRecords("Accounting","(Request_Key:equals:" + v53 + ")",1,10);
	if(vx == "Send deposit invoice")
	{
		v0 = "request_deposit";
	}
	if(v3p != null)
	{
		for each  v1k in v3p
		{
			v4v = v1k.get("Sales_Order");
			if(ifnull(v1k.get("Request_Key"),"").toString() == v53 && ifnull(v1k.get("Request_Source"),"").toString() == "Sales Orders" && v4v != null && ifnull(v4v.get("id"),"").toString() == sid)
			{
				v4w = zoho.crm.getRecordById("Accounting",v1k.get("id").toLong());
				if(vx == "Send deposit invoice" && v4w != null && ifnull(v4w.get("QBO_Invoice_ID"),"").toString().trim() != "")
				{
					v0 = "deposit";
				}
				if(vx == "Deposit paid" && ifnull(v48.get("Status"),"").toString() == "Ordered" && ifnull(v1k.get("Request_Status"),"").toString() == "Deposit Paid" && ifnull(v1k.get("Deposit_Receipt_Sent"),false).toString().toLowerCase() != "true")
				{
					v0 = "deposit_received";
				}
			}
		}
	}
}
info "[SalesOrder] Accounting_status=" + vx + ", selected=" + v0;
if(ifnull(v48.get("Front_Send_Guard"),"").toString().startsWith(v0 + ":SENT") || (v0 == "deposit" || v0 == "invoice") && ifnull(v48.get("Invoice_sent_on"),"").toString() != "")
{
	info "[DISPATCH] Already sent " + sid + " " + v0;
	return;
}
if(v0 == "sync_qbo")
{
	info "[SO QBO] Sync start: " + sid;
	s = zoho.crm.getRecordById("Sales_Orders",sid.toLong());
	if(s == null || s.get("id") == null)
	{
		info "[SO QBO] ERROR: Sales Order missing";
		return;
	}
	st = ifnull(s.get("Status"),"").toString();
	if(st != "Requested" && st != "Ordered" && st != "Shipped")
	{
		return;
	}
	if(ifnull(s.get("Company_selection"),"").toString() == "EU Company")
	{
		return;
	}
	nb = ifnull(s.get("Grand_Total"),0).toDecimal().round(2);
	paid = ifnull(s.get("Amount_Paid"),0).toDecimal().round(2);
	no = ifnull(s.get("Subject"),"").toString();
	v2c = no;
	if(v2c.length() > 21)
	{
		v2c = v2c.subString(0,21);
	}
	key1 = "SO_" + sid + "_DEPOSIT";
	items = zoho.crm.searchRecords("Accounting","(Request_Key:equals:" + key1 + ")",1,10);
	accId = "";
	cnt = 0;
	if(items != null)
	{
		for each  item in items
		{
			link = item.get("Sales_Order");
			if(ifnull(item.get("Request_Key"),"").toString() == key1 && ifnull(item.get("Request_Source"),"").toString() == "Sales Orders" && link != null && ifnull(link.get("id"),"").toString() == sid)
			{
				accId = item.get("id").toString();
				cnt = cnt + 1;
			}
		}
	}
	if(cnt == 0)
	{
		return;
	}
	if(cnt != 1 || nb <= 0 || no == "")
	{
		info "[SO QBO] ERROR: Deposit request or total invalid";
		return;
	}
	acc = zoho.crm.getRecordById("Accounting",accId.toLong());
	if(acc == null || acc.get("id") == null)
	{
		return;
	}
	iid = ifnull(acc.get("QBO_Invoice_ID"),"").toString();
	realm = ifnull(zoho.crm.getOrgVariable("QBO_REALM_ID"),"").toString();
	if(iid == "")
	{
		return;
	}
	if(realm == "")
	{
		info "[SO QBO] ERROR: Missing realm";
		return;
	}
	base = "https://quickbooks.api.intuit.com/v3/company/" + realm;
	hdr = {"Accept":"application/json","Content-Type":"application/json"};
	try 
	{
		got = invokeurl
		[
			url :base + "/invoice/" + iid
			type :GET
			headers:hdr
			connection:"quickbooks_online"
		];
	}
	catch (ex)
	{
		info "[SO QBO] ERROR read: " + ex;
		return;
	}
	if(got == null || got.get("Invoice") == null)
	{
		info "[SO QBO] ERROR: QBO Invoice unavailable";
		return;
	}
	inv = got.get("Invoice");
	nd = ifnull(inv.get("TotalAmt"),0).toDecimal().round(2);
	v54 = ifnull(inv.get("Balance"),0).toDecimal().round(2);
	qpaid = (nd - v54).round(2);
	curr = inv.get("CurrencyRef");
	if(ifnull(inv.get("Id"),"").toString() != iid || ifnull(inv.get("DocNumber"),"").toString() != v2c || ifnull(inv.get("SyncToken"),"").toString() == "" || curr != null && ifnull(curr.get("value"),"").toString() != ifnull(s.get("Currency"),"").toString())
	{
		info "[SO QBO] ERROR: Invoice ID, number, currency or token mismatch";
		return;
	}
	if(nb < qpaid || qpaid != paid || nd <= 0 || v54 < 0)
	{
		info "[SO QBO] ERROR: Amount or applied payments mismatch: CRM=" + paid + " QBO=" + qpaid;
		return;
	}
	if(nb != nd)
	{
		lines = inv.get("Line");
		if(lines == null || lines.size() == 0 || lines.size() > 2)
		{
			info "[SO QBO] ERROR: Unsupported invoice lines";
			return;
		}
		if(lines.size() == 2 && ifnull(lines.get(1).get("DetailType"),"") != "SubTotalLineDetail")
		{
			info "[SO QBO] ERROR: Unexpected QBO invoice line";
			return;
		}
		ln = lines.get(0);
		ld = ln.get("SalesItemLineDetail");
		if(ld == null || ifnull(ln.get("DetailType"),"").toString() != "SalesItemLineDetail" || ld.get("ItemRef") == null || ifnull(ld.get("ItemRef").get("value"),"").toString() != "1" || ifnull(ld.get("Qty"),0).toDecimal() != 1 || ifnull(ln.get("Amount"),0).toDecimal().round(2) != nd)
		{
			info "[SO QBO] ERROR: Invoice is not the original one-line Sales Order summary";
			return;
		}
		nld = {"ItemRef":ld.get("ItemRef"),"Qty":1,"UnitPrice":nb};
		if(ld.get("TaxCodeRef") != null)
		{
			nld.put("TaxCodeRef",ld.get("TaxCodeRef"));
		}
		nln = {"DetailType":"SalesItemLineDetail","Amount":nb,"Description":ifnull(ln.get("Description"),"Sales Order " + no),"SalesItemLineDetail":nld};
		if(ln.get("Id") != null)
		{
			nln.put("Id",ln.get("Id"));
		}
		v5f = {"Id":iid,"SyncToken":inv.get("SyncToken"),"sparse":true,"Line":{nln}};
		try 
