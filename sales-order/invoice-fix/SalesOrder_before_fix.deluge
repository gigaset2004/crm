			resp = invokeurl
			[
				url :base + "/invoice"
				type :POST
				parameters:v5f.toString()
				headers:hdr
				connection:"quickbooks_online"
			];
		}
		catch (ex2)
		{
			info "[SO QBO] ERROR update: " + ex2;
			return;
		}
		if(resp == null || resp.get("Invoice") == null || ifnull(resp.get("Invoice").get("Id"),"").toString() != iid)
		{
			info "[SO QBO] ERROR update rejected: " + resp;
			return;
		}
		v50 = ifnull(resp.get("Invoice").get("TotalAmt"),0).toDecimal().round(2);
		v58 = ifnull(resp.get("Invoice").get("Balance"),0).toDecimal().round(2);
		if(v50 != nb || (v50 - v58).round(2) != qpaid)
		{
			info "[SO QBO] ERROR verifying total or payments: " + resp;
			return;
		}
		info "[SO QBO] UPDATED total " + nd + " -> " + v50 + "; paid " + qpaid;
	}
	bkey = "SO_" + sid + "_BALANCE";
	brows = zoho.crm.searchRecords("Accounting","(Request_Key:equals:" + bkey + ")",1,10);
	bid = "";
	bcount = 0;
	if(brows != null)
	{
		for each  b in brows
		{
			bl = b.get("Sales_Order");
			if(ifnull(b.get("Request_Key"),"").toString() == bkey)
			{
				bcount = bcount + 1;
				if(bl != null && ifnull(bl.get("id"),"").toString() == sid && ifnull(b.get("Request_Source"),"").toString() == "Sales Orders")
				{
					bid = b.get("id").toString();
				}
			}
		}
	}
	if(bcount > 1 || bcount == 1 && bid == "")
	{
		info "[SO QBO] ERROR: Duplicate or invalid balance request";
		return;
	}
	if(bid != "")
	{
		brec = zoho.crm.getRecordById("Accounting",bid.toLong());
		remain = (ifnull(brec.get("Payment_Amount"),0).toDecimal() + nb - nd).round(2);
		if(brec != null && brec.get("id") != null && ifnull(brec.get("Payment_Amount"),0).toDecimal().round(2) != remain)
		{
			r = zoho.crm.updateRecord("Accounting",bid.toLong(),{"Payment_Amount":remain},{"trigger":List()});
			if(r == null || ifnull(r.get("id"),"").toString() != bid)
			{
				info "[SO QBO] ERROR updating Accounting balance: " + r;
				return;
			}
			info "[SO QBO] Accounting balance updated to=" + remain;
		}
	}
	info "[SO QBO] DONE " + no + "; total=" + nb;
	return;
}
if(v0 == "deposit_received" || v0 == "payment_received")
