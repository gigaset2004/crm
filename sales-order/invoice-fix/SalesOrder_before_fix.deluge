		info "[SO Dep Rec] SKIP: Accounting deposit is not confirmed.";
		return;
	}
	if(!vd && ifnull(acc.get("Deposit_Receipt_Sent"),false).toString().toLowerCase() == "true" || vd && ifnull(acc.get("Payment_Received_Sent"),false).toString().toLowerCase() == "true")
	{
		info "[SO Dep Rec] SKIP: Confirmation email already sent.";
		return;
	}
	info "[SO Receipt] Preparing confirmation email.";
	vg = "4888374000129665206";
	vo = "4888374000000343119";
	if(vd)
	{
		vg = "4888374000131503163";
	}
	n3 = List();
	n4 = so.get("Contact_Name");
	if(n4 != null && n4.get("id") != null)
	{
		n1 = zoho.crm.getRecordById("Contacts",n4.get("id").toLong());
		if(n1 != null && n1.get("id") != null)
		{
			for each  n5 in {"Email","Secondary_Email"}
			{
				n0 = ifnull(n1.get(n5),"").toString().trim();
				if(n0 != "" && n0.contains("@"))
				{
					n3.add(n0);
				}
			}
		}
	}
	n6 = so.get("Account_Name");
	if(n6 != null && n6.get("id") != null)
	{
		n2 = zoho.crm.getRecordById("Accounts",n6.get("id").toLong());
		if(n2 != null && n2.get("id") != null)
		{
			for each  n5 in {"Company_email","Alternative_email_1","Alternative_email_2"}
			{
				n0 = ifnull(n2.get(n5),"").toString().trim();
				if(n0 != "" && n0.contains("@"))
